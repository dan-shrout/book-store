@using BookStore.Models.ViewModels;
@model ProductVM

<div class="container-fluid py-3">
    <a asp-action="Index" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i> Back to products
    </a>
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #065f46, #282828, #191414);">
            <h5 class="mb-0 fw-bold"><i class="bi bi-plus-lg me-2"></i>Create Product</h5>
            <p class="mb-0 small" style="color: #1DB954;">Add a new product for your products</p>
        </div>
        <div class="card-body p-4">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <form method="post">
            <div class="col-lg-8">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row-lg-3">
            <div class="col-12">
                <label asp-for="Product.Title" class="form-label fw-semibold small"></label>
                <input type="text" asp-for="Product.Title" class="form-control" placeholder="Enter product name" />
                <span class="text-danger small" asp-validation-for="Product.Title"></span>
            </div>
         <div class="col-12">
            <label asp-for="Product.Description" class="form-label fw-semibold small"></label>
            <input type="text" asp-for="Product.Description" class="form-control" placeholder="Enter product description" />
            <span class="text-danger small" asp-validation-for="Product.Description"></span>
        </div>
         <div class="col-6">
            <label asp-for="Product.ISBN" class="form-label fw-semibold small"></label>
            <input type="text" asp-for="Product.ISBN" class="form-control" placeholder="Enter ISBN" />
            <span class="text-danger small" asp-validation-for="Product.ISBN"></span>
        </div>
         <div class="col-6">
            <label asp-for="Product.Author" class="form-label fw-semibold small"></label>
            <input type="text" name="Author" asp-for="Product.Author" class="form-control" placeholder="Enter author author" />
            <span class="text-danger small" asp-validation-for="Product.Author"></span>
        </div>
    </div>
    <div class="border rounded p-3 mt-3 bg-light">
    <p class="text-uppercase fw-semibold text-secondary mb-3" style="font-size: 0.65rem; letter-spacing: 0.1em;"></p>
    <div class="row g-3">
        <div class="col-6 col-md-3">
            <label asp-for="Product.ListPrice" class="form-label fw-semibold small"></label>
            <input type="text" asp-for="Product.ListPrice" class="form-control"/>
            <span class="text-danger small" asp-validation-for="Product.ListPrice"></span>
        </div>
           <div class="col-6 col-md-3">
            <label asp-for="Product.Price" class="form-label fw-semibold small"></label>
            <input type="text" asp-for="Product.Price" class="form-control"/>
            <span class="text-danger small" asp-validation-for="Product.Price"></span>
        </div>
           <div class="col-6 col-md-3">
            <label asp-for="Product.Price50" class="form-label fw-semibold small"></label>
            <input type="text" asp-for="Product.Price50" class="form-control"/>
            <span class="text-danger small" asp-validation-for="Product.Price50"></span>
        </div>
           <div class="col-6 col-md-3">
            <label asp-for="Product.Price100" class="form-label fw-semibold small"></label>
            <input type="text" asp-for="Product.Price100" class="form-control"/>
            <span class="text-danger small" asp-validation-for="Product.Price100"></span>
        </div>
    </div>

          <div class="mt-3">
            <label asp-for="Product.CategoryId" class="form-label fw-semibold small"></label>
            <select asp-for="Product.CategoryId" class="form-select" asp-items="@Model.CategoryList">
                <option disabled selected>--Select Category--</option>
            </select>
            <span class="text-danger small" asp-validation-for="Product.CategoryId"></span>
          </div>

    </div>
    </div>
    
    <div class="col-lg-4">

    </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-accent fw-semibold">Create Product</button>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-light fw-medium">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}